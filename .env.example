# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/karyakode"

# Admin dashboard
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Optional contact lead email notifications via Resend
# Leave all three unset to keep contact form persistence working without email.
RESEND_API_KEY=""
CONTACT_NOTIFICATION_EMAIL=""
# Must be a sender/domain verified with Resend, e.g. "KaryaKode <leads@your-verified-domain.com>"
CONTACT_FROM_EMAIL=""
